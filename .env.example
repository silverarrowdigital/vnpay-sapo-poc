# Copy to .env.local and fill in. Never commit real values.
# None of these use the NEXT_PUBLIC_ prefix, so they are never sent to the browser.

# --- App ---------------------------------------------------------------------
# Public HTTPS base URL of this app, no trailing slash. Used to build the VNPAY return URL
# (<APP_BASE_URL>/api/vnpay/return). Must be reachable by the customer's browser.
APP_BASE_URL=https://your-public-url.example.com

# --- VNPAY Sandbox -------------------------------------------------------------
# From the VNPAY sandbox registration email ("Thông tin cấu hình").
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET
# Optional. Defaults to the official sandbox payment page.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Optional, scripts only (`npm run querydr`, `npm run refund`). Defaults to the SANDBOX endpoint. When
# VNPAY_PAYMENT_URL points anywhere else (production), these scripts refuse to run until this is set
# too, so a production lookup or refund can never silently hit the sandbox.
# VNPAY_QUERYDR_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# NOTE: the IPN URL is NOT an env var. Set it in the VNPAY sandbox merchant portal to:
#   <APP_BASE_URL>/api/vnpay/ipn

# --- Sapo (Private App) ---------------------------------------------------------
# Store domain without https://, e.g. mystore.mysapo.net
SAPO_STORE_DOMAIN=your-store.mysapo.net
# Sapo admin → Ứng dụng → Ứng dụng riêng (Private app). Needs "Đơn hàng" (Orders) read & write.
SAPO_API_KEY=YOUR_SAPO_PRIVATE_APP_API_KEY
SAPO_API_SECRET=YOUR_SAPO_PRIVATE_APP_API_SECRET
# Optional. Numeric variant id of a real Sapo product to attach the line item to.
# When set, a paid order also DEDUCTS STOCK for that variant (inventory_behaviour
# "decrement_ignoring_policy": never refused, may go negative).
# Leave empty to create a custom line item (title "Test Product", SKU TEST-001) and move no stock.
SAPO_VARIANT_ID=

# Ask Sapo to email the customer its own order confirmation when an order is created.
# Only the literal "true" turns it on. OFF by default on purpose: switching it on makes Sapo send
# mail to a real address the moment an order lands, so it has to be the shop's decision, not a
# side effect of a deploy. Whether Sapo actually delivers that mail for an API-created order is
# NOT verified in this repo — finding out means sending a real email, which cannot be undone.
# Set to "false" to stop honouring discount codes — every code, within one request, no deploy.
# An operational kill switch: discount codes live in Sapo and this app has READ-ONLY access to
# them on purpose, so there is no way from here to retire a code that should no longer exist.
# Default (unset) is ON, so this variable changes nothing until you set it.
DISCOUNTS_ENABLED=

SAPO_SEND_RECEIPT=

# Who a refund is recorded as being requested by (vnp_CreateBy on the VNPAY refund API).
# Only used by `npm run refund`. Defaults to "shop-admin".
VNPAY_REFUND_CREATE_BY=

# --- Redis (optional, but REQUIRED on serverless/Vercel) -------------------------
# Shared store for pending orders. Without it the app keeps them in an in-memory Map, which
# only works when checkout and the VNPAY IPN reach the SAME Node process (local `next dev` /
# `next start`). On Vercel each request may hit a different instance, so a paid order would be
# lost: the IPN answers 01 and no Sapo order is created.
#
# Create a Redis database from the Vercel Marketplace (Upstash) and Vercel injects the KV_* pair
# automatically. A database created directly at Upstash gives the UPSTASH_* pair instead.
# Either pair works; set only one. UPSTASH_* wins if both are present.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Overrides the Redis key namespace for pending orders.
# One Redis database is attached to every Vercel environment, so keys are namespaced to stop a
# preview deployment from writing records production would mis-read: production uses no namespace,
# a preview uses "preview-<branch>", a local server uses "local". Set this to override, or to an
# empty string to deliberately share production's namespace — which lets a local server finish an
# order whose IPN VNPAY delivered to the production deployment, and is only safe while local and
# production agree on the shape of a pending order.
# ORDER_STORE_NAMESPACE=

# --- Sanity CMS (optional) -------------------------------------------------------
# Holds product descriptions as composable blocks (slider, FAQ, video, specs) and, from T2, the
# blog. ALL OF THESE ARE OPTIONAL: with SANITY_PROJECT_ID unset the product page simply shows the
# plain-text description Sapo returns, exactly as it did before the CMS existed. A Sanity outage
# degrades the page the same way. This is the opposite of SAPO_*, which must block checkout when
# missing, because Sapo holds price and stock while Sanity only holds presentation.
#
# From sanity.io/manage, or printed by `npx sanity init`.
SANITY_PROJECT_ID=
# Optional. Defaults to "production".
SANITY_DATASET=
# Optional. Pinned API date; defaults to 2026-10-01. Use a date, never "v1" or "X".
SANITY_API_VERSION=
# Optional read token. LEAVE THIS EMPTY — the storefront reads published content anonymously.
#
# A token forces reads past Sanity's CDN to the origin: slower, and counted against the costlier
# request quota, which is the limit the free plan hits first. Published content is public anyway,
# so a token protects nothing here.
#
# Kept only for a possible future preview mode that reads drafts (which would also need
# lib/sanity.ts to stop pinning perspective "published").
SANITY_READ_TOKEN=

# Shared secret for Sanity's content webhook -> /api/revalidate. Any long random string; set the
# same value when creating the webhook in Sanity.
#
# This is what lets blog queries be cached for an hour and product content for five minutes: the
# webhook clears the cache the moment something is published, so a long window costs no freshness.
# Unset, /api/revalidate refuses every request - an endpoint that empties the cache on demand must
# never be callable by anyone who asks.
SANITY_WEBHOOK_SECRET=

# The same two values again, under the prefix the Sanity CLI exposes to the Studio bundle
# (sanity.config.ts / sanity.cli.ts). Only needed to run or deploy the Studio itself
# (`npm run studio:dev`, `npm run studio:deploy`), not to serve the storefront.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# --- Order alerts (T10 PR 3) -------------------------------------------------------------------
# An email to the shop owner when a customer has paid and no order could be recorded: Sapo failed,
# VNPAY confirmed a reference this shop has no record of, or the amount did not match. Without both
# RESEND_API_KEY and ALERT_EMAIL alerts are off and the only trace is the `alert.not_configured`
# log line. RESEND_API_KEY is what Vercel's Resend integration is expected to inject (not yet seen
# live). ALERT_EMAIL_FROM is optional: the default is Resend's shared sender (onboarding@resend.dev),
# which is believed to deliver only to the address the Resend account was opened with (UNVERIFIED —
# send one test alert and record what happened), so set ALERT_EMAIL to that address until a
# sending domain of the shop's own is verified.
RESEND_API_KEY=
ALERT_EMAIL=
# (ALERT_EMAIL_TO, the first name of this variable, is still read when ALERT_EMAIL is not set.)
# ALERT_EMAIL_FROM=Order alerts <onboarding@resend.dev>

# --- Contact form (T12.3) ------------------------------------------------------------------------
# Where messages from the form on /lien-he land. Uses RESEND_API_KEY from above. Unset ⇒ the form is
# not drawn and the page shows only the shop's phone and email. Until a sending domain of the shop's
# own is verified, Resend's shared sender is believed to deliver only to the address the Resend
# account was opened with (UNVERIFIED), so use that address.
CONTACT_EMAIL=
# (CONTACT_EMAIL_TO, the first name of this variable, is still read when CONTACT_EMAIL is not set.)
