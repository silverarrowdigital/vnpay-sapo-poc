{
  "name": "vnpay-sapo-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate:ipn": "node --env-file=.env.local scripts/simulate-ipn.mjs",
    "clean:orders": "node --env-file=.env.local scripts/delete-test-orders.mjs",
    "replay-ipn": "node --env-file=.env.local scripts/replay-ipn.mjs",
    "replay:last": "node scripts/auto-ipn.mjs",
    "watch:ipn": "node scripts/auto-ipn.mjs --watch",
    "fetch:reference": "node scripts/fetch-reference.mjs",
    "studio:dev": "sanity dev",
    "studio:deploy": "sanity deploy",
    "check:revalidate": "node --env-file=.env.local scripts/check-revalidate.mjs",
    "check:sapo-scopes": "node --env-file=.env.local scripts/check-sapo-scopes.mjs",
    "querydr": "node --env-file=.env.local scripts/querydr.mjs",
    "check:locations": "node --env-file=.env.local scripts/check-locations.mjs",
    "refund": "node --env-file=.env.local scripts/refund.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.9.0",
    "@sanity/webhook": "^4.0.4",
    "@upstash/redis": "^1.39.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@sanity/vision": "^6.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "sanity": "^6.17.0",
    "styled-components": "^6.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
